YMMPSVersion: "1"
Sequences:
  - ID: opening
    Scenes:
      - ID: title_scene
        Shots:
          - ID: title_shot
            Items:
              - Type: VideoItem
                Template: title_video
                Length: "150"
              - Type: TachieItem
                Template: character_stand
                Length: "UNTIL SHOT END"
                
  - ID: main_content
    Scenes:
      - ID: intro_scene
        Shots:
          - ID: intro_shot
            Items:
              - Type: VoiceItem
                Template: narrator_voice
                Length: "300"
                Properties:
                  Serif: "Welcome to our video tutorial"
              - Type: TachieItem
                Template: character_stand
                Length: "UNTIL SCENE END"
                
      - ID: explanation_scene
        Shots:
          - ID: explain_shot1
            Items:
              - Type: VoiceItem
                Template: narrator_voice
                Length: "240"
                Properties:
                  Serif: "First, let me explain the basics"
          - ID: explain_shot2
            Items:
              - Type: VoiceItem
                Template: narrator_voice
                Length: "180"
                Properties:
                  Serif: "Now, let's look at an example"
              - Type: VideoItem
                Template: example_video
                Length: "UNTIL SHOT END"